<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>overlay</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../contracts/cs/Ipc.g.cs" Link="Contracts/Ipc.g.cs" />
        <Compile Include="../contracts/cs/MapDisplay.g.cs" Link="Contracts/MapDisplay.g.cs" />
        <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
        <PackageReference Include="Svg.Skia" Version="3.5.0" />
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
        <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
        <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
        <PackageReference Include="BruTile" Version="6.0.0" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    </ItemGroup>
</Project>
