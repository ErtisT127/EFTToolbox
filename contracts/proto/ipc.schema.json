        "lockAspect": {
          "type": "boolean"
        },
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "x-step": 1,
          "x-precision": 0
        },
        "backdrop": {
          "type": "boolean"
        },
        "svgResolution": {
          "type": "integer"
        },
        "svgQualityMode": {
          "type": "string",
          "enum": ["auto", "fixed"]
        },
        "followCenter": {
          "type": "boolean"
        },
        "followFloor": {
          "type": "boolean"
        },
        "followZoom": {
          "type": "boolean"
        },
        "targetZoom": {
          "type": "number",
          "minimum": -10,
          "maximum": 12,
          "x-step": 0.1,
          "x-precision": 1
