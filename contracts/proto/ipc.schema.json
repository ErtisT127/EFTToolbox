{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efttoolbox.local/ipc.schema.json",
  "$defs": {
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "appVersion", "startedAt"],
      "properties": {
        "protocolVersion": {
          "type": "string",
          "const": "1"
        },
        "appVersion": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string"
        }
      }
    },
    "ServerEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sentAt", "status"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "snapshot",
            "heartbeat",
            "map_changed",
            "mode_applied",
            "player_upsert",
            "player_remove",
            "annotation_upsert",
            "annotation_remove",
            "preferences_changed",
            "annotations_changed",
            "overlay_settings",
            "overlay_command",
            "overlay_status",
            "resources_changed",
            "game_monitor_changed",
            "calibration_changed"
          ]
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "mapId": {
          "type": "string"
        },
        "player": {
          "$ref": "#/$defs/PlayerState"
        },
        "playerId": {
          "type": "string"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlayerState"
          }
        },
        "annotation": {
          "$ref": "#/$defs/SharedAnnotation"
        },
        "annotationId": {
          "type": "string"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SharedAnnotation"
          }
        },
        "operationId": {
          "type": "string"
        },
        "preferences": {
          "$ref": "#/$defs/Preferences"
        },
        "overlaySettings": {
          "$ref": "#/$defs/OverlaySettings"
        },
        "overlayView": {
          "$ref": "#/$defs/OverlayView"
        },
        "overlayCommand": {
          "$ref": "#/$defs/OverlayCommand"
        },
        "gameMonitorStatus": {
          "$ref": "#/$defs/GameMonitorStatus"
        }
      }
    },
    "GameMonitorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "screenshotDirectory",
        "logDirectory",
        "deleteScreenshots",
        "autoMapSwitch",
        "mode"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "screenshotDirectory": { "type": "string" },
        "logDirectory": { "type": "string" },
        "deleteScreenshots": { "type": "boolean" },
        "autoMapSwitch": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["pvp", "pve", "pvp-season"] }
      }
    },
    "GameMonitorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "screenshotWatching",
        "logWatching",
        "mapId",
        "lastScreenshotAt",
        "lastLogAt"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "mode": { "type": "string", "enum": ["pvp", "pve", "pvp-season"] },
        "screenshotWatching": { "type": "boolean" },
        "logWatching": { "type": "boolean" },
        "mapId": { "type": "string" },
        "lastScreenshotAt": { "type": "string" },
        "lastLogAt": { "type": "string" }
      }
    },
    "PlayerState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId",
        "displayName",
        "isSelf",
        "mapId",
        "worldPosition",
        "mapPosition",
        "resolution",
        "heading"
      ],
      "properties": {
        "playerId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "isSelf": {
          "type": "boolean"
        },
        "mapId": {
          "type": "string"
        },
        "worldPosition": {
          "$ref": "#/$defs/WorldPosition"
        },
        "mapPosition": {
          "$ref": "#/$defs/MapPoint"
        },
        "resolution": {
          "$ref": "#/$defs/LocationResolution"
        },
        "heading": {
          "type": "number"
        }
      }
    },
    "SharedAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "ownerId",
        "revision",
        "mapId",
        "floorId",
        "kind",
        "points",
        "color",
        "width",
        "emoji",
        "imageId",
        "text",
        "textSize"
      ],
      "properties": {
        "itemId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "mapId": {
          "type": "string"
        },
        "floorId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["marker", "stroke"]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapPoint"
          }
        },
        "color": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "emoji": {
          "type": "string"
        },
        "imageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "textSize": {
          "type": "number"
        }
      }
    },
    "MapPoint": {
      "description": "Coordinates are displayed rounded to x-precision digits; user-supplied coordinates are additionally bounded by the server to ±1e7.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "x-precision": 2
        },
        "y": {
          "type": "number",
          "x-precision": 2
        }
      }
    },
    "WorldPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "x-precision": 2 },
        "y": { "type": "number", "x-precision": 2 },
        "z": { "type": "number", "x-precision": 2 }
      }
    },
    "WorldXZ": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "number", "x-precision": 2 },
        "z": { "type": "number", "x-precision": 2 }
      }
    },
    "WorldRectXZ": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minX", "maxX", "minZ", "maxZ"],
      "properties": {
        "minX": { "type": "number", "x-precision": 2 },
        "maxX": { "type": "number", "x-precision": 2 },
        "minZ": { "type": "number", "x-precision": 2 },
        "maxZ": { "type": "number", "x-precision": 2 }
      }
    },
    "YRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number", "x-precision": 2 },
        "max": { "type": "number", "x-precision": 2 }
      }
    },
    "CalibrationRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "floorId", "name", "rectangle", "yRange", "priority", "coversEntireMap"],
      "properties": {
        "id": { "type": "string" },
        "floorId": { "type": "string" },
        "name": { "type": "string" },
        "rectangle": { "$ref": "#/$defs/WorldRectXZ" },
        "yRange": { "$ref": "#/$defs/YRange" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 9999, "x-step": 1 },
        "coversEntireMap": { "type": "boolean" }
      }
    },
    "CalibrationDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mapId", "basemap", "revision", "nextRegionNumber", "regions"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "mapId": { "type": "string" },
        "basemap": { "type": "string", "enum": ["svg", "tiles"] },
        "revision": { "type": "integer", "minimum": 0 },
        "nextRegionNumber": { "type": "integer", "minimum": 1 },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/CalibrationRegion" } }
      }
    },
    "CalibrationDocuments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "maps"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "maps": { "type": "array", "items": { "$ref": "#/$defs/CalibrationDocument" } }
      }
    },
    "LocationResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "floorId", "regionId", "candidates"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["resolved", "ambiguous", "unresolved", "skipped"]
        },
        "floorId": { "type": ["string", "null"] },
        "regionId": { "type": ["string", "null"] },
        "candidates": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotation", "bounds", "viewBox"],
      "properties": {
        "rotation": {
          "type": "number"
        },
        "bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorldXZ"
          }
        },
        "viewBox": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "Floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "svgGroups"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "svgGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "groupId", "color", "symbol", "iconUrl"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "iconUrl": {
          "type": "string"
        }
      }
    },
    "BuiltinMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "categoryId",
        "categoryIds",
        "floorIds",
        "position",
        "outline",
        "taskId",
        "iconUrl",
        "labelSize",
        "labelRotation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "categoryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "floorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "position": {
          "$ref": "#/$defs/MapPoint"
        },
        "outline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapPoint"
          }
        },
        "taskId": {
          "type": "string"
        },
        "iconUrl": {
          "type": "string"
        },
        "labelSize": {
          "type": "number"
        },
        "labelRotation": {
          "type": "number"
        }
      }
    },
    "MapTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "MapSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "subtitle", "defaultFloor", "iconUrl"],
      "properties": {
        "iconUrl": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "defaultFloor": {
          "type": "string"
        }
      }
    },
    "MapData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iconUrl",
        "schemaVersion",
        "id",
        "name",
        "subtitle",
        "defaultFloor",
        "svgUrl",
        "projection",
        "floors",
        "categories",
        "markers",
        "tasks",
        "raidDuration",
        "players",
        "warnings",
        "clock",
        "baseFloor",
        "tiles"
      ],
      "properties": {
        "iconUrl": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "defaultFloor": {
          "type": "string"
        },
        "svgUrl": {
          "type": "string"
        },
        "projection": {
          "$ref": "#/$defs/Projection"
        },
        "floors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Floor"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Category"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BuiltinMarker"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapTask"
          }
        },
        "raidDuration": {
          "type": "number"
        },
        "players": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clock": {
          "$ref": "#/$defs/MapClock"
        },
        "baseFloor": {
          "type": "string"
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TileLayer"
          }
        }
      }
    },
    "Annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "floorId",
        "kind",
        "points",
        "color",
        "width",
        "emoji",
        "imageId",
        "text",
        "textSize"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "floorId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["marker", "stroke"]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapPoint"
          }
        },
        "color": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "emoji": {
          "type": "string"
        },
        "imageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "textSize": {
          "type": "number"
        }
      }
    },
    "Annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "items"],
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Annotation"
          }
        }
      }
    },
    "MapPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapId",
        "basemap",
        "floorId",
        "hiddenCategories",
        "collapsedGroups",
        "showAnnotations",
        "selectedTasks",
        "center",
        "zoom",
        "taskFilterActive",
        "basemap"
      ],
      "properties": {
        "mapId": {
          "type": "string"
        },
        "basemap": {
          "type": "string",
          "enum": ["svg", "tiles"]
        },
        "floorId": {
          "type": "string"
        },
        "hiddenCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collapsedGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "showAnnotations": {
          "type": "boolean"
        },
        "selectedTasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "zoom": {
          "type": "number"
        },
        "taskFilterActive": {
          "type": "boolean"
        },
        "basemap": {
          "type": "string"
        }
      }
    },
    "CalibratorSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mapId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["map", "floor", "region"]
        },
        "mapId": {
          "type": "string"
        },
        "floorId": {
          "type": "string"
        },
        "regionId": {
          "type": "string"
        }
      }
    },
    "CalibratorPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sidebarCollapsed", "collapsedMaps", "collapsedFloors"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "sidebarCollapsed": {
          "type": "boolean"
        },
        "collapsedMaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collapsedFloors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selection": {
          "$ref": "#/$defs/CalibratorSelection"
        }
      }
    },
    "Preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "selectedMap", "maps", "stickerUsage"],
      "properties": {
        "schemaVersion": {
          "type": "integer"
        },
        "selectedMap": {
          "type": "string"
        },
        "maps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapPreference"
          }
        },
        "stickerUsage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StickerUsage"
          }
        }
      }
    },
    "StickerUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "count"],
      "properties": {
        "id": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "Sticker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "iconUrl"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "iconUrl": {
          "type": "string"
        }
      }
    },
    "DaylightPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "icon", "label"],
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "icon": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "MapClock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "offsets", "fixed", "phases"],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DaylightPhase"
          }
        },
        "rate": {
          "type": "number"
        },
        "offsets": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TileLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "floorId",
        "sourceUrl",
        "url",
        "tileSize",
        "minZoom",
        "maxZoom",
        "transform",
        "bounds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "floorId": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "tileSize": {
          "type": "integer"
        },
        "minZoom": {
          "type": "integer"
        },
        "maxZoom": {
          "type": "integer"
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapPoint"
          }
        }
      }
    },
    "OverlayHotkeys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toggleEdit",
        "toggleVisible",
        "zoomIn",
        "zoomOut",
        "floorUp",
        "floorDown",
        "toggleBasemap",
        "panUp",
        "panDown",
        "panLeft",
        "panRight"
      ],
      "properties": {
        "toggleEdit": {
          "type": "string"
        },
        "toggleVisible": {
          "type": "string"
        },
        "zoomIn": {
          "type": "string"
        },
        "zoomOut": {
          "type": "string"
        },
        "floorUp": {
          "type": "string"
        },
        "floorDown": {
          "type": "string"
        },
        "toggleBasemap": {
          "type": "string"
        },
        "panUp": {
          "type": "string"
        },
        "panDown": {
          "type": "string"
        },
        "panLeft": {
          "type": "string"
        },
        "panRight": {
          "type": "string"
        }
      }
    },
    "MapZoomOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapId", "zoom"],
      "properties": {
        "mapId": {
          "type": "string"
        },
        "zoom": {
          "type": "number",
          "minimum": -10,
          "maximum": 12,
          "x-step": 0.1,
          "x-precision": 1
        }
      }
    },
    "OverlaySettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
