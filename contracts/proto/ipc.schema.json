          "type": "array",
          "items": {
            "$ref": "#/$defs/MapZoomOverride"
          }
        },
        "devPlayerEnabled": {
          "type": "boolean"
        },
        "hotkeys": {
          "$ref": "#/$defs/OverlayHotkeys"
        }
      }
    },
