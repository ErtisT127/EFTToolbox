          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "mapId": {
          "type": "string"
        },
        "floorId": {
          "type": "string"
        },
        "basemap": {
          "type": "string"
