        "height": {
          "type": "integer",
          "minimum": 160,
          "maximum": 2048,
          "x-step": 16,
          "x-precision": 0
        },
        "left": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000,
          "x-step": 1,
          "x-precision": 0
