{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efttoolbox.local/signal.schema.json",
  "title": "EFTToolbox multiplayer signaling protocol",
  "$defs": {
    "SignalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "payload"],
      "properties": {
        "nonce": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 16,
          "maxLength": 16
        },
        "payload": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 1,
          "maxLength": 2097152
        }
      }
    },
    "SignalError": {
      "type": "string",
      "enum": [
        "multiplayer_signal_invalid",
        "multiplayer_key_invalid",
        "multiplayer_room_full",
        "multiplayer_share_invalid",
        "multiplayer_connection_failed",
        "multiplayer_signaling_timeout",
        "multiplayer_stun_failed"
      ]
    },
    "SignalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "payload"],
      "properties": {
        "nonce": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 16,
          "maxLength": 16
        },
        "payload": {
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 1,
          "maxLength": 2097152
        }
      }
    },
    "SignalPayloadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offer"],
      "properties": {
        "offer": { "type": "string", "minLength": 1, "maxLength": 1048576 }
      }
    },
    "SignalPayloadResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "error": { "$ref": "#/$defs/SignalError" },
        "detail": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
