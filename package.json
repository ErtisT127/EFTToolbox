{
  "name": "efttoolbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "toolbox": "node scripts/cli.mjs",
    "test:maps": "node --test dashboard/test/map-tests.mjs",
    "contracts": "node contracts/generate.mjs",
    "contracts:check": "node contracts/generate.mjs --check && node contracts/check.mjs",
    "defaults": "node scripts/generate-defaults.mjs",
    "defaults:check": "node scripts/generate-defaults.mjs --check",
    "third-party": "node scripts/generate-third-party.mjs",
    "third-party:check": "node scripts/generate-third-party.mjs --check",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build": "pnpm contracts && pnpm defaults && pnpm third-party && pnpm --filter @efttoolbox/dashboard build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdi/js": "7.4.47",
    "@xmldom/xmldom": "^0.9.12",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^7.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "yaml": "^2.8.1",
    "wawoff2": "^2.0.1"
  }
}
