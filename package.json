{
  "name": "efttoolbox",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "contracts": "node contracts/generate.mjs",
    "contracts:check": "node contracts/generate.mjs --check",
    "build": "pnpm contracts && pnpm --filter @efttoolbox/dashboard build",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
